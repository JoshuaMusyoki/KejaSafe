# Copy to release.config.ps1 (git-ignored) and fill in for your Google Cloud project.
# Both deploy-api.ps1 and deploy-web.ps1 read this file.

# Google Cloud project that owns Cloud Run, Cloud SQL and the uploads bucket.
$ProjectId = "kejasafe"

# africa-south1 is Johannesburg, the closest region to Kenya. Cloud SQL, the Artifact
# Registry repository and the Cloud Run service should all share it.
$Region = "africa-south1"

$ServiceName = "kejasafe-api"
$Repository  = "kejasafe"

# Cloud SQL for PostgreSQL. The instance connection name is <project>:<region>:<instance>.
$SqlInstance = "kejasafe-db"
$SqlDatabase = "kejasafe"
$SqlUser     = "kejasafe"

# Bucket mounted over the container's upload directory, so listing photos and KYC
# documents survive instance restarts.
$UploadsBucket = "kejasafe-uploads"

# Firebase Hosting site. Leave blank to use the project's default site, which serves on
# <project>.web.app.
$HostingSite = ""

# Origins allowed to call the API from a browser, comma separated. Include every domain
# that serves the web app; an empty value allows any origin, which is for local dev only.
$AllowedOrigins = "https://kejasafe.web.app,https://kejasafe.firebaseapp.com"

# Base URL the deployed web app calls. Leave blank to reuse the Cloud Run service URL
# that deploy-api.ps1 prints, or set a custom domain such as https://api.kejasafe.co.ke.
$ApiBaseUrl = ""
